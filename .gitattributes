# Keep line endings LF everywhere, in the repository and in the working tree.
# Without this a Windows checkout with core.autocrlf=true writes CRLF files, which
# gofmt reports as unformatted and which makes generated output differ from the
# same generation run on another platform.
* text=auto eol=lf

# Generated by the mapper itself, listed so diffs of regenerated files stay readable
example/gen/gen.go linguist-generated=true

*.png binary
*.jpg binary
*.pdf binary
*.exe binary
